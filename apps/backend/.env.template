STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# eAWB / Europarcel — configure only in backend, never NEXT_PUBLIC_*.
# Default off: existing shipping remains active until rollout is complete.
EAWB_ENABLED=false
EAWB_API_URL=https://api.europarcel.com/api/public
EAWB_API_KEY=
EAWB_BILLING_ADDRESS_ID=
EAWB_SENDER_ADDRESS_ID=
# Optional allowlist of carrier IDs; empty = all available door-to-door carriers.
EAWB_CARRIER_IDS=
EAWB_PAYMENT_MODES=card,cod
# Inclusive item total after discounts; off disables free shipping.
EAWB_FREE_SHIPPING_THRESHOLD=500
EAWB_BANK_IBAN=
EAWB_BANK_HOLDER=
EAWB_TIMEOUT_MS=15000
# Separate switch: true allows Fulfill items in admin to purchase an AWB.
EAWB_CREATE_AWB_ENABLED=false
